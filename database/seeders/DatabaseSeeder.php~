<?php

namespace Database\Seeders;

use Illuminate\Database\Seeder;
use Illuminate\Support\Facades\DB;
use Illuminate\Support\Facades\Hash;
use App\Models\User;
use Spatie\Permission\Models\Role;
use Spatie\Permission\Models\Permission;

class DatabaseSeeder extends Seeder
{
    public function run(): void
    {
        // 1. Define ALL unique granular permissions across all modules
        $permissions = [
            // Job Cards
            'job_cards.view_any', 'job_cards.view_all', 'job_cards.view_own',
            'job_cards.create', 'job_cards.update_all', 'job_cards.update_own',
            'job_cards.delete', 'job_cards.restore', 'job_cards.force_delete',

            // Customers
            'customers.view_any', 'customers.create', 'customers.update',
            'customers.delete', 'customers.restore', 'customers.force_delete',

            // Vehicles
            'vehicles.view_any', 'vehicles.create', 'vehicles.update',
            'vehicles.delete', 'vehicles.restore', 'vehicles.force_delete',

            // Invoices
            'invoices.view_any', 'invoices.create', 'invoices.update',
            'invoices.delete', 'invoices.restore', 'invoices.force_delete',

            // Inventory
            'inventory.view_any', 'inventory.create', 'inventory.update',
            'inventory.delete', 'inventory.restore', 'inventory.force_delete',

            // Suppliers
            'suppliers.view_any', 'suppliers.create', 'suppliers.update',
            'suppliers.delete', 'suppliers.restore', 'suppliers.force_delete',

            // Inspection Items
            'inspection_items.view_any', 'inspection_items.create', 'inspection_items.update',
            'inspection_items.delete', 'inspection_items.restore', 'inspection_items.force_delete',

            // Branches
            'branches.view_any', 'branches.create', 'branches.update',
            'branches.delete', 'branches.restore', 'branches.force_delete',

            // Users
            'users.view_any', 'users.create', 'users.update',
            'users.delete', 'users.restore', 'users.force_delete',

            // Appointments
            'appointments.view_any', 'appointments.create', 'appointments.update',
            'appointments.delete', 'appointments.restore',
        ];

        // Ensure all permissions exist in database
        foreach ($permissions as $permission) {
            Permission::firstOrCreate([
                'name' => $permission,
                'guard_name' => 'web',
            ]);
        }

        // 2. Define Role to Permission mappings
        $rolePermissions = [
            'admin' => $permissions, // Full access

            'manager' => [
                'job_cards.view_any', 'job_cards.view_all', 'job_cards.create',
                'job_cards.update_all', 'job_cards.delete', 'job_cards.restore',

                'customers.view_any', 'customers.create', 'customers.update',
                'customers.delete', 'customers.restore',

                'vehicles.view_any', 'vehicles.create', 'vehicles.update',
                'vehicles.delete', 'vehicles.restore',

                'invoices.view_any', 'invoices.create', 'invoices.update',
                'invoices.delete', 'invoices.restore',

                'inventory.view_any', 'inventory.create', 'inventory.update',
                'inventory.delete', 'inventory.restore',

                'suppliers.view_any', 'suppliers.create', 'suppliers.update',
                'suppliers.delete', 'suppliers.restore',

                'inspection_items.view_any', 'inspection_items.create', 'inspection_items.update',

                'branches.view_any', 'branches.create', 'branches.update',

                'appointments.view_any', 'appointments.create', 'appointments.update',
                'appointments.delete', 'appointments.restore',
            ],

            'service_advisor' => [
                'job_cards.view_any', 'job_cards.view_all', 'job_cards.create', 'job_cards.update_all',
                'customers.view_any', 'customers.create', 'customers.update',
                'vehicles.view_any', 'vehicles.create', 'vehicles.update',
                'invoices.view_any',
                'inventory.view_any',
            ],

            'mechanic' => [
                'job_cards.view_any', 'job_cards.view_own', 'job_cards.update_own',
                'inventory.view_any',
                'suppliers.view_any',
            ],

            'receptionist' => [
                'job_cards.view_any', 'job_cards.view_all', 'job_cards.create',
                'customers.view_any', 'customers.create', 'customers.update',
                'vehicles.view_any', 'vehicles.create', 'vehicles.update',
                'appointments.view_any', 'appointments.create', 'appointments.update',
            ],

            'cashier' => [
                'job_cards.view_any', 'job_cards.view_all',
                'customers.view_any',
                'vehicles.view_any',
                'invoices.view_any', 'invoices.create', 'invoices.update',
            ],

            'inventory_manager' => [
                'inventory.view_any', 'inventory.create', 'inventory.update',
                'inventory.delete', 'inventory.restore',
                'suppliers.view_any', 'suppliers.create', 'suppliers.update',
                'suppliers.delete', 'suppliers.restore',
            ],
        ];

        // Create roles and sync assigned permissions
        foreach ($rolePermissions as $roleName => $assignedPermissions) {
            $role = Role::firstOrCreate([
                'name' => $roleName,
                'guard_name' => 'web',
            ]);
            $role->syncPermissions($assignedPermissions);
        }

        // 3. Base Branch setup
        DB::table('branches')->updateOrInsert(
            ['name' => 'AutoTrack Bole'],
            [
                'phone'      => '+251 11 123 4567',
                'address'    => 'Bole Road, Addis Ababa',
                'is_active'  => true,
                'created_at' => now(),
                'updated_at' => now(),
            ]
        );

        $branchId = DB::table('branches')->where('name', 'AutoTrack Bole')->value('id');

        // 4. Default Admin User setup
        $admin = User::updateOrCreate(
            ['email' => 'admin@autotrack.et'],
            [
                'branch_id'  => $branchId,
                'name'       => 'AutoTrack Admin',
                'password'   => Hash::make('password'),
                'phone'      => '+251 91 000 0000',
                'role'       => 'admin',
                'is_active'  => true,
            ]
        );

        $admin->assignRole('admin');

        if (class_exists(TestUsersSeeder::class)) {
            $this->call(TestUsersSeeder::class);
        }
    }
}
