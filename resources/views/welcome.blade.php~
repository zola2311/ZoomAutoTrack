<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AutoTrack Ethiopia — Garage Management & Digital Vehicle Passport</title>
    <meta name="description" content="AutoTrack Ethiopia gives every garage a digital job card system and every vehicle a permanent, verifiable service history — accessible by QR code.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg: #14181B;
            --bg-2: #1B2126;
            --bg-3: #222A30;
            --border: rgba(255,255,255,0.09);
            --border-strong: rgba(255,255,255,0.16);
            --text: #EDEEEC;
            --text-muted: #9BA3A8;
            --text-faint: #6C767B;
            --amber: #E8963C;
            --amber-dim: rgba(232,150,60,0.14);
            --blue: #4E93CE;
            --blue-dim: rgba(78,147,206,0.14);
            --green: #6FAE5C;
            --green-dim: rgba(111,174,92,0.14);
            --red: #D2645A;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        html { scroll-behavior: smooth; }
        body {
            background: var(--bg);
            color: var(--text);
            font-family: 'Inter', sans-serif;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }
        h1, h2, h3, .display {
            font-family: 'Oswald', sans-serif;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.02em;
            line-height: 1.1;
        }
        .mono { font-family: 'JetBrains Mono', monospace; }
        a { color: inherit; text-decoration: none; }
        img, svg { display: block; max-width: 100%; }
        .wrap { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
        .section { padding: 96px 0; }
        .eyebrow {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: var(--amber);
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }
        .eyebrow::before {
            content: '';
            width: 20px;
            height: 1px;
            background: var(--amber);
            display: inline-block;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 14px;
            padding: 14px 26px;
            border-radius: 3px;
            cursor: pointer;
            transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
            border: 1px solid transparent;
        }
        .btn:hover { transform: translateY(-1px); }
        .btn-primary { background: var(--amber); color: #1B1207; }
        .btn-primary:hover { background: #F0A650; }
        .btn-ghost { border-color: var(--border-strong); color: var(--text); }
        .btn-ghost:hover { border-color: var(--amber); color: var(--amber); }

        /* NAV */
        nav {
            position: sticky; top: 0; z-index: 50;
            background: rgba(20,24,27,0.88);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
        }
        nav .wrap { display: flex; align-items: center; justify-content: space-between; height: 76px; }
        .logo { display: flex; align-items: center; gap: 10px; font-family: 'Oswald', sans-serif; font-size: 20px; font-weight: 600; letter-spacing: 0.02em; }
        .logo-mark { width: 30px; height: 30px; border: 1.5px solid var(--amber); border-radius: 4px; display: flex; align-items: center; justify-content: center; color: var(--amber); font-size: 14px; font-weight: 700; }
        .nav-links { display: flex; align-items: center; gap: 36px; }
        .nav-links a { font-size: 14px; color: var(--text-muted); transition: color 0.15s; }
        .nav-links a:hover { color: var(--text); }
        .nav-cta { display: flex; align-items: center; gap: 16px; }
        .nav-cta .btn { padding: 10px 20px; }

        /* HERO */
        .hero { padding: 88px 0 64px; position: relative; overflow: hidden; }
        .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 64px; align-items: center; }
        .hero h1 { font-size: 52px; margin-bottom: 22px; }
        .hero h1 span { color: var(--amber); }
        .hero p.lede { font-size: 18px; color: var(--text-muted); max-width: 480px; margin-bottom: 34px; }
        .hero-actions { display: flex; gap: 14px; margin-bottom: 40px; }
        .hero-trust { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--text-faint); }
        .hero-trust .dot { width: 5px; height: 5px; border-radius: 50%; background: var(--green); }

        /* PASSPORT CARD - signature element */
        .passport-wrap { position: relative; }
        .passport-card {
            background: var(--bg-2);
            border: 1px solid var(--border-strong);
            border-radius: 10px;
            overflow: hidden;
            position: relative;
            box-shadow: 0 30px 60px -20px rgba(0,0,0,0.5);
        }
        .passport-head {
            background: var(--bg-3);
            padding: 18px 22px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 1px solid var(--border);
        }
        .passport-head .plate { font-family: 'JetBrains Mono', monospace; font-size: 15px; letter-spacing: 0.06em; color: var(--text); }
        .passport-head .sub { font-size: 11px; color: var(--text-faint); margin-top: 3px; }
        .passport-score { text-align: right; }
        .passport-score .num { font-family: 'Oswald', sans-serif; font-size: 26px; color: var(--green); font-weight: 600; }
        .passport-score .lbl { font-size: 10px; color: var(--text-faint); text-transform: uppercase; letter-spacing: 0.06em; }
        .passport-body { padding: 22px; position: relative; }
        .scan-row { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
        .scan-label { font-size: 12px; color: var(--text-muted); min-width: 78px; }
        .scan-track { flex: 1; height: 6px; background: var(--bg-3); border-radius: 3px; overflow: hidden; }
        .scan-fill { height: 100%; border-radius: 3px; }
        .scan-val { font-family: 'JetBrains Mono', monospace; font-size: 12px; min-width: 28px; text-align: right; }
        .scanline {
            position: absolute; left: 22px; right: 22px; height: 2px;
            background: linear-gradient(90deg, transparent, var(--amber), transparent);
            opacity: 0.7;
            animation: scan 2.6s ease-in-out infinite;
        }
        @keyframes scan {
            0%, 100% { top: 20px; opacity: 0; }
            10% { opacity: 0.8; }
            50% { top: 210px; opacity: 0.8; }
            90% { opacity: 0.8; }
        }
        .passport-footer {
            border-top: 1px solid var(--border);
            padding: 16px 22px;
            display: flex; align-items: center; gap: 12px;
            font-size: 12px; color: var(--text-faint);
        }
        .qr-mini {
            width: 34px; height: 34px; border: 1px solid var(--border-strong); border-radius: 4px;
            display: flex; align-items: center; justify-content: center; color: var(--text-faint); font-size: 16px;
        }
        @media (prefers-reduced-motion: reduce) { .scanline { animation: none; opacity: 0; } }

        /* STAT STRIP */
        .stat-strip { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); background: var(--bg-2); }
        .stat-strip .wrap { display: grid; grid-template-columns: repeat(4, 1fr); padding: 30px 32px; }
        .stat-item { text-align: center; border-right: 1px solid var(--border); padding: 0 12px; }
        .stat-item:last-child { border-right: none; }
        .stat-item .val { font-family: 'Oswald', sans-serif; font-size: 26px; color: var(--amber); }
        .stat-item .lbl { font-size: 12px; color: var(--text-faint); margin-top: 4px; }

        /* PROBLEM */
        .problem-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 48px; }
        .problem-card { background: var(--bg-2); border: 1px solid var(--border); border-radius: 8px; padding: 28px; }
        .problem-card .icon { width: 40px; height: 40px; border-radius: 8px; background: rgba(210,100,90,0.14); color: var(--red); display: flex; align-items: center; justify-content: center; margin-bottom: 18px; font-size: 18px; }
        .problem-card h3 { font-size: 16px; text-transform: none; letter-spacing: 0; margin-bottom: 8px; }
        .problem-card p { font-size: 14px; color: var(--text-muted); }

        /* HOW IT WORKS */
        .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; margin-top: 56px; position: relative; }
        .step { padding: 0 24px; position: relative; }
        .step:not(:first-child)::before {
            content: ''; position: absolute; left: 0; top: 22px; width: 1px; height: calc(100% - 40px);
            background: var(--border-strong);
        }
        .step-num { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--amber); margin-bottom: 14px; }
        .step h3 { font-size: 19px; text-transform: none; letter-spacing: 0; margin-bottom: 10px; }
        .step p { font-size: 14px; color: var(--text-muted); }

        /* FEATURES */
        .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--border); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; margin-top: 48px; }
        .feature-card { background: var(--bg-2); padding: 32px; transition: background 0.15s; }
        .feature-card:hover { background: var(--bg-3); }
        .feature-card .icon { color: var(--blue); font-size: 20px; margin-bottom: 16px; }
        .feature-card h3 { font-size: 16px; text-transform: none; letter-spacing: 0; margin-bottom: 8px; }
        .feature-card p { font-size: 13.5px; color: var(--text-muted); }

        /* PASSPORT SHOWCASE */
        .showcase { background: var(--bg-2); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
        .showcase-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center; }
        .showcase h2 { font-size: 36px; margin-bottom: 20px; }
        .showcase p.lede { color: var(--text-muted); font-size: 16px; margin-bottom: 28px; max-width: 440px; }
        .showcase-list { display: flex; flex-direction: column; gap: 16px; }
        .showcase-list li { display: flex; gap: 12px; align-items: flex-start; list-style: none; font-size: 14.5px; color: var(--text-muted); }
        .showcase-list .check { width: 18px; height: 18px; border-radius: 50%; background: var(--green-dim); color: var(--green); display: flex; align-items: center; justify-content: center; font-size: 11px; flex-shrink: 0; margin-top: 2px; }

        /* TRUST */
        .trust-band { text-align: center; }
        .trust-band .eyebrow { justify-content: center; }
        .trust-band .eyebrow::before { display: none; }
        .trust-band h2 { font-size: 26px; max-width: 640px; margin: 0 auto 16px; text-transform: none; letter-spacing: 0; }
        .trust-band p { color: var(--text-muted); max-width: 560px; margin: 0 auto; font-size: 15px; }
        .trust-logos { display: flex; justify-content: center; gap: 40px; margin-top: 44px; flex-wrap: wrap; }
        .trust-logos span { font-family: 'JetBrains Mono', monospace; font-size: 13px; color: var(--text-faint); border: 1px solid var(--border); padding: 10px 18px; border-radius: 4px; }

        /* CTA BANNER */
        .cta-banner { background: linear-gradient(180deg, var(--bg-2), var(--bg)); text-align: center; }
        .cta-banner h2 { font-size: 34px; margin-bottom: 16px; }
        .cta-banner p { color: var(--text-muted); margin-bottom: 32px; }
        .cta-actions { display: flex; gap: 14px; justify-content: center; }

        /* FOOTER */
        footer { border-top: 1px solid var(--border); padding: 56px 0 32px; }
        .footer-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 48px; }
        .footer-brand p { color: var(--text-faint); font-size: 13.5px; margin-top: 14px; max-width: 260px; }
        .footer-col h4 { font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); margin-bottom: 16px; font-family: 'Inter', sans-serif; font-weight: 600; }
        .footer-col a { display: block; font-size: 14px; color: var(--text-muted); margin-bottom: 10px; }
        .footer-col a:hover { color: var(--text); }
        .footer-bottom { border-top: 1px solid var(--border); padding-top: 24px; display: flex; justify-content: space-between; font-size: 12.5px; color: var(--text-faint); }

        @media (max-width: 860px) {
            .nav-links { display: none; }
            .hero-grid, .showcase-grid { grid-template-columns: 1fr; }
            .hero h1 { font-size: 36px; }
            .problem-grid, .feature-grid, .steps { grid-template-columns: 1fr; }
            .stat-strip .wrap { grid-template-columns: repeat(2, 1fr); gap: 20px 0; }
            .footer-grid { grid-template-columns: 1fr 1fr; }
        }
    </style>
</head>
